# Gradle files
.gradle/
build/
.*/
!.github/
!.github/workflows/

# Local configuration file (sdk path, etc)
local.properties
build_install.bat

# docs 为本地内部文档，不参与 git 同步
docs/

# Log/OS Files
*.log

# Temporary files (local scratch dir, not synced)
/tmp/

# Android Studio generated files and folders
captures/
.externalNativeBuild/
.cxx/
*.aab
*.apk
output-metadata.json

# IntelliJ
*.iml
.idea/
misc.xml
deploymentTargetDropDown.xml
render.experimental.xml

# Keystore files
*.jks
*.keystore
keystore.properties

# Google Drive 内置 OAuth 客户端凭据（构建期注入，绝不入库）
gdrive.properties

# Google Services (e.g. APIs or Firebase)
google-services.json

# Android Profiling
*.hprof

# mibackpc（电脑端接收器）构建产物统一输出 pc/dist/（pc/ 根不落 exe）与本地配置
pc/dist/
pc/mibackpc.json
pc/harness/build/
pc/harness/harness_out.txt
pc/harness_out.txt
pc/blackbox_out.txt

# 目标应用反编译产物（jadx 生成，仅供分析，不同步）
decompiled_xpbackup/
