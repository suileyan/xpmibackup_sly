<?xml version="1.0" encoding="utf-8"?>
<!--
  Material Design 3 色彩体系 —— 浅色
  ─────────────────────────────────────────────────────────────
  主色板由品牌橙 #FF6900 生成 MD3 角色（primary / on-primary /
  primary-container / on-primary-container）；表面走 MD3 三级 surface-container
  色阶（同一色系低饱和阶，层级靠色阶而非描边）。
  兼容别名：所有旧色名（background/surface/text_*/danger/tab_selected_bg 等）
  保留并指向新色板，Java 直引 R.color.* 与旧布局引用不断。
  可访问性：正文/次要文字对表面色阶均满足 WCAG 2.1 AA（≥4.5:1）。
-->
<resources>
    <!-- ========== MD3 主色板（品牌橙 #FF6900 派生） ========== -->
    <color name="md3_primary">#B84E00</color>
    <color name="md3_on_primary">#FFFFFF</color>
    <color name="md3_primary_container">#FFDBCC</color>
    <color name="md3_on_primary_container">#3E1400</color>
    <color name="md3_inverse_primary">#FF8B5E</color>

    <!-- 品牌强调（点缀 / 主 CTA 填充 / 选中态图标）—— 指向 primary 语义 -->
    <color name="brand">#B84E00</color>
    <color name="brand_pressed">#943D00</color>
    <color name="on_brand">#FFFFFF</color>
    <color name="brand_container">#FFDBCC</color>
    <color name="brand_container_pressed">#FFE3D6</color>

    <!-- ========== 兼容别名（旧引用，语义等价） ========== -->
    <color name="primary">#B84E00</color>
    <color name="primary_dark">#943D00</color>
    <color name="primary_light">#F1F1F1</color>
    <color name="primary_text_on">#FFFFFF</color>

    <!-- ========== 页面与表面（MD3 surface-container 色阶） ========== -->
    <color name="md3_surface">#FBF8F4</color>
    <color name="md3_on_surface">#1F1B18</color>
    <color name="md3_surface_container_low">#F3F0EB</color>
    <color name="md3_surface_container">#EDEAE4</color>
    <color name="md3_surface_container_high">#E8E4DF</color>
    <color name="md3_surface_container_highest">#E2DED8</color>
    <color name="md3_on_surface_variant">#4F4640</color>
    <color name="md3_outline">#817A73</color>
    <color name="md3_outline_variant">#C9C0B7</color>

    <!-- 旧色名 → MD3 表面色阶别名 -->
    <color name="background">#FBF8F4</color>
    <color name="surface">#FBF8F4</color>
    <color name="surface_variant">#EDEAE4</color>
    <color name="input_bg">#F3F0EB</color>
    <color name="surface_pressed">#E8E4DF</color>
    <color name="card_border">#E2DED8</color>
    <color name="divider">#1A4F4640</color>
    <color name="outline">#817A73</color>
    <color name="status_bar">#FBF8F4</color>

    <!-- 导航栏与浮层（MD3：导航栏 = surface-container，顶部 1px outline 分割） -->
    <color name="nav_bar">#EDEAE4</color>
    <color name="nav_bar_border">#C9C0B7</color>
    <color name="scrim">#4D000000</color>
    <color name="ripple">#1A4F4640</color>
    <color name="ripple_on_brand">#33FFFFFF</color>

    <!-- ========== 文字层级（MD3 on-surface） ========== -->
    <color name="md3_on_surface_primary">#1F1B18</color>
    <color name="md3_on_surface_secondary">#4F4640</color>
    <color name="md3_on_surface_hint">#787067</color>
    <color name="md3_on_surface_disabled">#A39B93</color>

    <color name="text_primary">#1F1B18</color>
    <color name="text_secondary">#4F4640</color>
    <color name="text_tertiary">#787067</color>
    <color name="text_hint">#787067</color>
    <color name="text_disabled">#A39B93</color>
    <color name="text_on_brand">#FFFFFF</color>

    <!-- ========== Tab / 图标底板（MD3 primary-container 选中态） ========== -->
    <color name="tab_selected_bg">#FFDBCC</color>
    <color name="tab_icon_selected">#3E1400</color>
    <color name="tab_icon_idle">#4F4640</color>
    <color name="tab_text_selected">#3E1400</color>
    <color name="tab_text_idle">#4F4640</color>
    <color name="icon_tile">#EDEAE4</color>
    <color name="icon_on_tile">#4F4640</color>

    <!-- ========== 语义色（MD3 错误/成功/警告角色） ========== -->
    <color name="md3_error">#BA1A1A</color>
    <color name="md3_on_error">#FFFFFF</color>
    <color name="md3_error_container">#FFDAD6</color>
    <color name="md3_success">#3B6F2F</color>
    <color name="md3_warning">#8A5A00</color>

    <color name="danger">#BA1A1A</color>
    <color name="danger_pressed">#970009</color>
    <color name="danger_container">#FFDAD6</color>
    <color name="success">#3B6F2F</color>
    <color name="warning">#8A5A00</color>
</resources>
