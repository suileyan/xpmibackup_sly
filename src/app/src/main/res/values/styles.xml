<?xml version="1.0" encoding="utf-8"?>
<!--
  Material Design 3 样式表 —— 浅色
  ─────────────────────────────────────────────────────────────
  设计语言主线：MD3 表面色阶（surface-container 三级，层级靠色阶而非描边）、
  大圆角（按钮全圆角 999 / 卡片 16 / 输入 12）、品牌橙点缀、Type Scale 六档。
  零 Material 库依赖（Xposed 宿主类加载器安全）——全部用 framework 控件 +
  drawable 令牌重皮肤，样式名与旧版一致（Java/XML 直引不断）。
-->
<resources>

    <!-- ==================== 主题 ==================== -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/md3_primary</item>
        <item name="android:colorPrimaryDark">@color/brand_pressed</item>
        <item name="android:colorAccent">@color/md3_primary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:colorControlActivated">@color/md3_primary</item>
        <item name="android:colorControlHighlight">@color/ripple</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:alertDialogTheme">@style/XmDialogTheme</item>
        <!-- MD3 控件默认外观（framework 层） -->
        <item name="android:editTextColor">@color/text_primary</item>
        <item name="android:colorButtonNormal">@color/surface_variant</item>
    </style>

    <!-- 对话框：MD3 大圆角 + surface-container-highest 表面 -->
    <style name="XmDialogTheme" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/md3_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:windowMinWidthMajor">72%</item>
        <item name="android:windowMinWidthMinor">86%</item>
    </style>

    <!-- ==================== 文字层级（MD3 Type Scale） ==================== -->
    <!-- 页面主标题（Display small 档） -->
    <style name="XmTextPageTitle" parent="@android:style/TextAppearance.Material.Title">
        <item name="android:textSize">@dimen/text_page_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- 区块 / 卡片标题（Title medium） -->
    <style name="XmTextSection" parent="@android:style/TextAppearance.Material.Subhead">
        <item name="android:textSize">@dimen/text_section</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- 字段标签（Label large） -->
    <style name="XmTextLabel" parent="@android:style/TextAppearance.Material.Body2">
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <!-- 正文（Body large） -->
    <style name="XmTextBody" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <!-- 说明 / 提示（Label small / Caption） -->
    <style name="XmTextCaption" parent="@android:style/TextAppearance.Material.Caption">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/text_hint</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <!-- ==================== 容器（MD3 surface-container 色阶，去描边层级） ==================== -->
    <!-- 卡片：surface-container 阶 + 顶部极轻投影（仅悬浮层投影），无 1px 描边 -->
    <style name="XmCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/card_padding</item>
        <item name="android:layout_marginBottom">@dimen/card_gap</item>
    </style>

    <!-- 小卡片（单行信息 / 勾选项） -->
    <style name="XmCardRow" parent="XmCard">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/space_16</item>
        <item name="android:paddingEnd">@dimen/space_16</item>
        <item name="android:paddingTop">@dimen/space_12</item>
        <item name="android:paddingBottom">@dimen/space_12</item>
        <item name="android:layout_marginBottom">@dimen/card_gap</item>
    </style>

    <!-- ==================== 表单控件 ==================== -->
    <style name="XmInput" parent="@android:style/Widget.Material.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:paddingStart">@dimen/space_16</item>
        <item name="android:paddingEnd">@dimen/space_16</item>
        <item name="android:paddingTop">@dimen/space_12</item>
        <item name="android:paddingBottom">@dimen/space_12</item>
        <item name="android:textCursorDrawable">@drawable/bg_cursor</item>
    </style>

    <style name="XmSwitch" parent="@android:style/Widget.Material.CompoundButton.Switch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
    </style>

    <style name="XmRadio" parent="@android:style/Widget.Material.CompoundButton.RadioButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:paddingStart">@dimen/space_4</item>
    </style>

    <style name="XmCheckBox" parent="@android:style/Widget.Material.CompoundButton.CheckBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:paddingStart">@dimen/space_4</item>
    </style>

    <!-- ==================== 按钮（MD3 Filled / Outlined / 危险） ==================== -->
    <style name="XmButton" parent="@android:style/Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">@dimen/text_label</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:gravity">center</item>
    </style>

    <!--
      以下 4 个按钮变体必须显式继承 XmButton。
      layout_width / layout_height / minHeight / textAllCaps / stateListAnimator 等都定义在
      XmButton 上，若缺 parent，<Button style="@style/XmButtonPrimary"> 且未显式写
      layout_width 时，inflate 会抛
        UnsupportedOperationException: You must supply a layout_width attribute
      并被包装成 InflateException —— 表现为打开对应页面即闪退。
    -->

    <!-- 主 CTA：MD3 Filled Button（primary 填充 + on-primary 文字，全圆角） -->
    <style name="XmButtonPrimary" parent="XmButton">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/md3_on_primary</item>
    </style>

    <!-- 次按钮：MD3 Outlined（透明底 + outline 描边） -->
    <style name="XmButtonSecondary" parent="XmButton">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- 危险按钮：MD3 错误色填充 -->
    <style name="XmButtonDanger" parent="XmButton">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/md3_on_error</item>
    </style>

    <!-- 小尺寸按钮（列表行内）：覆盖 XmButton 的 match_parent 为 wrap_content -->
    <style name="XmButtonSmall" parent="XmButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:paddingStart">@dimen/space_12</item>
        <item name="android:paddingEnd">@dimen/space_12</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <!--
      顶部标题栏右侧动作（主 CTA 配色的紧凑胶囊）。
      不能直接用 XmButtonPrimary：它继承 XmButton 的 48dp minHeight 且没有水平内边距，
      放进 56dp 标题栏后胶囊被压成一根窄条、"完成"二字还会被裁掉（真机实测）。
    -->
    <style name="XmButtonTopAction" parent="XmButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">@dimen/space_16</item>
        <item name="android:paddingEnd">@dimen/space_16</item>
        <item name="android:paddingTop">@dimen/space_6</item>
        <item name="android:paddingBottom">@dimen/space_6</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/md3_on_primary</item>
    </style>

    <!-- ==================== 顶部标题栏 ==================== -->
    <style name="XmTopBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/top_bar_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@color/background</item>
        <item name="android:paddingStart">@dimen/space_20</item>
        <item name="android:paddingEnd">@dimen/space_8</item>
    </style>

    <!-- 顶栏图标按钮：48dp 圆形触控区，ripple 反馈（MD3 图标按钮规范） -->
    <style name="XmTopBarIconButton">
        <item name="android:layout_width">@dimen/touch_target_min</item>
        <item name="android:layout_height">@dimen/touch_target_min</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/bg_icon_button</item>
    </style>

    <!-- ==================== 导航栏（MD3 贴边全宽 Navigation Bar） ==================== -->
    <style name="XmNavBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/nav_bar_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_nav_bar</item>
        <item name="android:elevation">0dp</item>
        <item name="android:paddingStart">@dimen/space_8</item>
        <item name="android:paddingEnd">@dimen/space_8</item>
        <item name="android:paddingTop">@dimen/space_8</item>
        <item name="android:paddingBottom">@dimen/space_8</item>
    </style>

    <!-- 导航栏单项：48dp 最小触控，已选 = primary-container 胶囊 -->
    <style name="XmNavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/bg_nav_item</item>
        <item name="android:foreground">@drawable/ripple_nav_item</item>
    </style>

    <!-- 兼容旧引用：悬浮底栏样式（贴边后指向同一视觉，保留名供 activity_main 引用） -->
    <style name="XmFloatingBar" parent="XmNavBar">
        <item name="android:background">@drawable/bg_nav_bar</item>
    </style>

</resources>
