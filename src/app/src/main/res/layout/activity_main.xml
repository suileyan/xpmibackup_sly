<?xml version="1.0" encoding="utf-8"?>
<!--
  云备份助手主界面 —— 小米（HyperOS）应用设计语言
  ─────────────────────────────────────────────────────────────
  结构（自下而上）：
    · 根 FrameLayout 承载「内容层」与「悬浮底栏层」两个平面
    · 内容层：状态栏占位 → 顶部标题栏 → 内容区（Tab 层 + overlay 二级页面）→ 底部留白
    · 悬浮底栏层：脱离内容流，浮于内容之上，24dp 圆角 + elevation 投影 + 左右/底部留白
  底部留白（bottom_spacer）与底栏投影方向由 MainActivity.applyFloatingBarInsets() 统一维护：
  Android 15+ edge-to-edge 下按导航栏 inset 追加，避免被手势条遮挡。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ==================== 内容层 ==================== -->
    <LinearLayout
        android:id="@+id/content_column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 状态栏占位（仅 Android 15+ 强制 edge-to-edge 需要，见 MainActivity） -->
        <View
            android:id="@+id/status_bar_spacer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/status_bar" />

        <!-- 顶部标题栏：页面标题 + 更多菜单 -->
        <LinearLayout
            android:id="@+id/top_bar"
            style="@style/XmTopBar">

            <TextView
                android:id="@+id/tv_top_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/app_name"
                android:textAppearance="@style/XmTextPageTitle" />

            <TextView
                android:id="@+id/btn_top_menu"
                style="@style/XmTopBarIconButton"
                android:text="···"
                android:textSize="20sp"
                android:letterSpacing="-0.15"
                android:textColor="@color/text_primary"
                android:contentDescription="@string/more_menu" />
        </LinearLayout>

        <!-- 内容区：左侧导航栏占位（大屏横屏）+ Tab 页 / overlay 二级页面 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <View
                android:id="@+id/nav_rail_spacer"
                android:layout_width="0dp"
                android:layout_height="match_parent" />

            <FrameLayout
                android:id="@+id/content_area"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <FrameLayout
                    android:id="@+id/fragment_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false" />

                <FrameLayout
                    android:id="@+id/overlay_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- 底部穿透区：高度恒 0——悬浮 dock 下内容直接穿过 dock 背后（遮挡仅 dock 本体），
             滚动到底的露出由各 Tab 页 ScrollView 底部 padding 预留；overlay 二级页面照常铺满。
             贴边样式下遮挡范围同样由 Tab 页 padding 承担。保留视图供 Java 统一维护（恒 0） -->
        <View
            android:id="@+id/bottom_spacer"
            android:layout_width="match_parent"
            android:layout_height="0dp" />
    </LinearLayout>

    <!-- ==================== 底部导航栏层（悬浮 / 贴边双样式，config.ini nav_bar_style） ==================== -->
    <!-- 悬浮（默认）：左右/底部留白 + 28dp 圆角 + elevation 投影，脱离屏幕边缘；
         贴边：MD3 全宽贴底，无圆角无投影，顶部 1px outline 分割。
         形态由 MainActivity.styleBottomBar() 运行时切换；
         Android 15+ edge-to-edge 下按导航栏 inset 抬升，避免被手势条遮挡 -->
    <LinearLayout
        android:id="@+id/tab_bar_container"
        style="@style/XmNavBar"
        android:layout_gravity="bottom">

        <!-- 设备配置 -->
        <LinearLayout
            android:id="@+id/tab_device"
            style="@style/XmNavItem"
            android:contentDescription="@string/tab_device_config">

            <FrameLayout
                android:id="@+id/tab_device_icon_box"
                android:layout_width="@dimen/floating_bar_core_icon"
                android:layout_height="@dimen/floating_bar_core_icon">

                <ImageView
                    android:id="@+id/tab_device_icon"
                    android:layout_width="@dimen/floating_bar_icon"
                    android:layout_height="@dimen/floating_bar_icon"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tab_device"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <TextView
                android:id="@+id/tab_device_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/tab_device_config"
                android:textSize="@dimen/text_tab"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- NAS 配置 -->
        <LinearLayout
            android:id="@+id/tab_service"
            style="@style/XmNavItem"
            android:contentDescription="@string/tab_service_config">

            <FrameLayout
                android:id="@+id/tab_service_icon_box"
                android:layout_width="@dimen/floating_bar_core_icon"
                android:layout_height="@dimen/floating_bar_core_icon">

                <ImageView
                    android:id="@+id/tab_service_icon"
                    android:layout_width="@dimen/floating_bar_icon"
                    android:layout_height="@dimen/floating_bar_icon"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tab_nas"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <TextView
                android:id="@+id/tab_service_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/tab_service_config"
                android:textSize="@dimen/text_tab"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- 云盘账号 -->
        <LinearLayout
            android:id="@+id/tab_account"
            style="@style/XmNavItem"
            android:contentDescription="@string/tab_account_config">

            <FrameLayout
                android:id="@+id/tab_account_icon_box"
                android:layout_width="@dimen/floating_bar_core_icon"
                android:layout_height="@dimen/floating_bar_core_icon">

                <ImageView
                    android:id="@+id/tab_account_icon"
                    android:layout_width="@dimen/floating_bar_icon"
                    android:layout_height="@dimen/floating_bar_icon"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tab_cloud"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <TextView
                android:id="@+id/tab_account_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/tab_account_config"
                android:textSize="@dimen/text_tab"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <!-- 备份：核心操作，图标常驻品牌色实心圆高亮 -->
        <LinearLayout
            android:id="@+id/tab_backup"
            style="@style/XmNavItem"
            android:contentDescription="@string/tab_backup_config">

            <FrameLayout
                android:id="@+id/tab_backup_icon_box"
                android:layout_width="@dimen/floating_bar_core_icon"
                android:layout_height="@dimen/floating_bar_core_icon"
                android:background="@drawable/bg_tab_core_icon">

                <ImageView
                    android:id="@+id/tab_backup_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tab_backup"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <TextView
                android:id="@+id/tab_backup_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/tab_backup_config"
                android:textSize="@dimen/text_tab"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
