<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 状态栏占位 -->
    <View
        android:id="@+id/status_bar_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/status_bar" />

    <!-- 顶部标题栏：LSPosed 风格主色条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/status_bar"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:letterSpacing="0.02" />

        <!-- 顶部菜单：点击弹出 设置 / 关于 -->
        <TextView
            android:id="@+id/btn_top_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="···"
            android:textSize="20sp"
            android:letterSpacing="-0.15"
            android:textColor="@color/text_primary"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />
    </LinearLayout>

    <!-- 内容区域：tab层(4页面常驻横向排开) + overlay层(二级页面) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false" />

        <FrameLayout
            android:id="@+id/overlay_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 底部Tab栏：LSPosed 风格胶囊选中态 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/surface"
        android:orientation="horizontal"
        android:gravity="center"
        android:elevation="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- 设备配置Tab -->
        <LinearLayout
            android:id="@+id/tab_device"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_tab_selected">

            <ImageView
                android:id="@+id/tab_device_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tab_device"
                android:importantForAccessibility="no"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tab_device_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_device_config"
                android:textSize="11sp"
                android:textColor="@color/primary" />
        </LinearLayout>

        <!-- 服务配置Tab -->
        <LinearLayout
            android:id="@+id/tab_service"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_tab_selected">

            <ImageView
                android:id="@+id/tab_service_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tab_nas"
                android:importantForAccessibility="no"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tab_service_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_service_config"
                android:textSize="11sp"
                android:textColor="@color/text_disabled" />
        </LinearLayout>

        <!-- 账号管理Tab -->
        <LinearLayout
            android:id="@+id/tab_account"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_tab_selected">

            <ImageView
                android:id="@+id/tab_account_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tab_cloud"
                android:importantForAccessibility="no"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tab_account_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_account_config"
                android:textSize="11sp"
                android:textColor="@color/text_disabled" />
        </LinearLayout>

        <!-- 备份Tab -->
        <LinearLayout
            android:id="@+id/tab_backup"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_tab_selected">

            <ImageView
                android:id="@+id/tab_backup_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tab_backup"
                android:importantForAccessibility="no"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tab_backup_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_backup_config"
                android:textSize="11sp"
                android:textColor="@color/text_disabled" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
