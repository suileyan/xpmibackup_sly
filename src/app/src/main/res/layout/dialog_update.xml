<?xml version="1.0" encoding="utf-8"?>
<!--
  版本更新弹窗内容（自定义视图）
  ─────────────────────────────────────────────────────────────
  不用框架 AlertDialog 的「3 按钮横排」：长中文标签「下载 APK（123 网盘）」
  「GitHub 发布页」在横排按钮条里会互相挤压 / 截断（排版错误）。
  改为纵向堆叠的全宽按钮：主操作（123 网盘）+ 次操作（GitHub）+ 文字取消。
  对话框圆角由 XmDialogTheme 的 windowBackground(@drawable/bg_dialog) 提供，
  本视图不放背景色，避免盖住圆角。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_24"
    android:paddingEnd="@dimen/space_24"
    android:paddingTop="@dimen/space_24"
    android:paddingBottom="@dimen/space_16">

    <TextView
        android:id="@+id/tv_update_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="-0.02"
        android:text="@string/update_dialog_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_page_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_update_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:lineSpacingMultiplier="1.4"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body" />

    <Button
        android:id="@+id/btn_update_download"
        style="@style/XmButtonPrimary"
        android:layout_marginTop="@dimen/space_24"
        android:text="@string/about_download_apk" />

    <Button
        android:id="@+id/btn_update_github"
        style="@style/XmButtonSecondary"
        android:layout_marginTop="@dimen/space_8"
        android:text="@string/about_open_browser" />

    <Button
        android:id="@+id/btn_update_cancel"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_target_min"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_8"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:minWidth="0dp"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_16"
        android:text="@android:string/cancel"
        android:textAllCaps="false"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_label" />

</LinearLayout>
