<?xml version="1.0" encoding="utf-8"?>
<!-- 设备配置页：分组卡片 + 8pt 栅格间距；页面标题由顶栏统一承担 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding_h"
        android:paddingEnd="@dimen/page_padding_h"
        android:paddingTop="@dimen/page_padding_top"
        android:paddingBottom="@dimen/page_padding_bottom">

        <!-- 设备信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/card_padding"
            android:layout_marginBottom="@dimen/card_gap">

            <TextView
                style="@style/XmTextSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_12"
                android:text="@string/device_info_section" />

            <TextView
                style="@style/XmTextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/label_gap"
                android:text="@string/device_name" />

            <EditText
                android:id="@+id/et_device_name"
                style="@style/XmInput"
                android:hint="@string/device_name_hint"
                android:inputType="text"
                android:layout_marginBottom="@dimen/field_gap" />

            <TextView
                style="@style/XmTextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/label_gap"
                android:text="@string/device_description" />

            <EditText
                android:id="@+id/et_device_describe"
                style="@style/XmInput"
                android:hint="@string/device_description_hint"
                android:inputType="text"
                android:layout_marginBottom="@dimen/field_gap" />

            <TextView
                style="@style/XmTextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/label_gap"
                android:text="@string/backup_path" />

            <TextView
                style="@style/XmTextCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8"
                android:text="@string/backup_path_description" />

            <EditText
                android:id="@+id/et_backup_path"
                style="@style/XmInput"
                android:hint="@string/backup_path_hint"
                android:inputType="text"
                android:layout_marginBottom="@dimen/field_gap" />

            <TextView
                style="@style/XmTextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/label_gap"
                android:text="@string/max_backup_count" />

            <TextView
                style="@style/XmTextCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_8"
                android:text="@string/max_backup_count_description" />

            <EditText
                android:id="@+id/et_backup_max"
                style="@style/XmInput"
                android:hint="5"
                android:inputType="number" />
        </LinearLayout>

        <!-- 日志 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="@dimen/card_padding"
            android:layout_marginBottom="@dimen/section_gap">

            <Switch
                android:id="@+id/sw_log_enabled"
                style="@style/XmSwitch"
                android:layout_width="match_parent"
                android:text="@string/write_error_log"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" />

            <TextView
                style="@style/XmTextCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:text="@string/log_path_hint" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_save"
            style="@style/XmButtonPrimary"
            android:text="@string/save_config" />

        <!-- 底部：Powered by + 作者 + 脚本帮助（与 NAS 页一致） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="@dimen/space_16">

            <TextView
                android:id="@+id/tv_footer"
                style="@style/XmTextCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/footer_text" />

            <TextView
                android:id="@+id/tv_footer_zgcwkj"
                style="@style/XmTextCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/space_4"
                android:paddingEnd="@dimen/space_4"
                android:text="@string/author"
                android:textColor="@color/brand" />

            <TextView
                android:id="@+id/tv_footer_suileyan"
                style="@style/XmTextCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/space_4"
                android:paddingEnd="@dimen/space_4"
                android:text="@string/footer_suileyan"
                android:textColor="@color/brand" />

            <TextView
                android:id="@+id/tv_script_help"
                style="@style/XmTextCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_16"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/space_4"
                android:paddingEnd="@dimen/space_4"
                android:text="@string/script_help_link"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
