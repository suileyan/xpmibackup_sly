<?xml version="1.0" encoding="utf-8"?>
<!-- 网页登录页（overlay 二级页面）：标题 + 完成键 + WebView + 底部提示 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- 标题行：标题 + 完成键 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_20"
        android:paddingEnd="@dimen/space_8">

        <TextView
            android:id="@+id/tv_webview_title"
            style="@style/XmTextSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/title_webview_login" />

        <Button
            android:id="@+id/btn_webview_done"
            style="@style/XmButtonTopAction"
            android:layout_marginStart="@dimen/space_12"
            android:text="@string/webview_login_done" />
    </LinearLayout>

    <!-- 应用内网页登录区 -->
    <WebView
        android:id="@+id/webview_login"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface"
        android:layout_marginStart="@dimen/page_padding_h"
        android:layout_marginEnd="@dimen/page_padding_h" />

    <TextView
        style="@style/XmTextCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_padding_h"
        android:paddingEnd="@dimen/page_padding_h"
        android:paddingTop="@dimen/space_12"
        android:paddingBottom="@dimen/space_16"
        android:text="@string/webview_login_tip" />
</LinearLayout>
