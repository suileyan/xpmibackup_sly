<?xml version="1.0" encoding="utf-8"?>
<!-- 设置页（overlay 二级页面）：自带标题行，页面打开时悬浮底栏收起 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_20"
        android:paddingEnd="@dimen/space_8">

        <TextView
            style="@style/XmTextPageTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding_h"
            android:paddingEnd="@dimen/page_padding_h"
            android:paddingBottom="@dimen/page_padding_bottom">

            <!-- 主题选择卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/card_padding"
                android:layout_marginBottom="@dimen/card_gap">

                <TextView
                    style="@style/XmTextSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_4"
                    android:text="@string/theme_mode" />

                <RadioGroup
                    android:id="@+id/rg_theme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_theme_system"
                        style="@style/XmRadio"
                        android:text="@string/theme_system" />

                    <RadioButton
                        android:id="@+id/rb_theme_day"
                        style="@style/XmRadio"
                        android:text="@string/theme_day" />

                    <RadioButton
                        android:id="@+id/rb_theme_night"
                        style="@style/XmRadio"
                        android:text="@string/theme_night" />
                </RadioGroup>
            </LinearLayout>

            <!-- 底栏样式卡片：悬浮 / 贴边切换，保存后即时生效 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/card_padding"
                android:layout_marginBottom="@dimen/card_gap">

                <TextView
                    style="@style/XmTextSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_4"
                    android:text="@string/nav_bar_style" />

                <RadioGroup
                    android:id="@+id/rg_nav_style"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rb_nav_floating"
                        style="@style/XmRadio"
                        android:text="@string/nav_style_floating" />

                    <RadioButton
                        android:id="@+id/rb_nav_fixed"
                        style="@style/XmRadio"
                        android:text="@string/nav_style_fixed" />
                </RadioGroup>
            </LinearLayout>

            <!-- 交互与更新卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/XmTextBody"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/predictive_back"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/XmTextCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:text="@string/predictive_back_hint" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/sw_predictive_back"
                        style="@style/XmSwitch" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/space_16">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/XmTextBody"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/update_check"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/XmTextCaption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:text="@string/update_check_hint" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/sw_update_check"
                        style="@style/XmSwitch" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
